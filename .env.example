# Daily Ink — environment template
# Copy this file to .env.local and replace the placeholders.
# Get values from Supabase: Dashboard → Project Settings → API

# Project URL (Settings → API → Project URL)
SUPABASE_URL=https://your-project.supabase.co

# Anon / public key (Settings → API → Project API keys → anon public)
# Safe to use in the browser. Never put the service_role key here.
SUPABASE_ANON_KEY=your-anon-key

# Domain used to build each account's synthetic sign-in address. Sign-in is
# username-only, so no real mailbox is ever involved. Must be a normal domain:
# Supabase rejects reserved names such as .local, .test and .invalid.
# Remember to uncheck "Confirm email" (Authentication → Providers → Email),
# otherwise signups are throttled and nobody can sign in.
VITE_AUTH_EMAIL_DOMAIN=dailyink.app
